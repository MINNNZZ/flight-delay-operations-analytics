        "lineageTag": "6bcb872a-5a72-4945-8807-d31489cf5584",
        "measures": [
          {
            "name": "Total Flights",
            "expression": "COUNTROWS(FactFlight)",
            "formatString": "#,0",
            "lineageTag": "e6bbb93d-7a7a-408d-838f-ccc2433cb500"
          },
          {
            "name": "Completed Flights",
            "expression": "SUM(FactFlight[COMPLETED])",
            "formatString": "#,0",
            "lineageTag": "7d68bf3a-b3cc-4eb6-9035-7b54bab0edcf"
          },
          {
            "name": "Arrival Eligible Flights",
            "expression": "SUM(FactFlight[ARR_ELIGIBLE])",
            "formatString": "#,0",
            "lineageTag": "701f36c6-f25d-4f25-963d-0391d3820f7b"
          },
          {
            "name": "Cancelled Flights",
            "expression": "SUM(FactFlight[CANCELLED])",
            "formatString": "#,0",
            "lineageTag": "ae70ac55-59c1-4cbb-9511-ef77c0bb1c9b"
          },
          {
            "name": "Diverted Flights",
            "expression": "SUM(FactFlight[DIVERTED])",
            "formatString": "#,0",
            "lineageTag": "e711f024-f6b2-4106-9f3e-fb3d235dc3a4"
          },
          {
            "name": "On-Time Flights",
            "expression": "SUM(FactFlight[ON_TIME])",
            "formatString": "#,0",
            "lineageTag": "ea80b307-4506-4bc6-8276-5e6d98d867ff"
          },
          {
            "name": "Severe Flights",
            "expression": "SUM(FactFlight[SEVERE_60])",
            "formatString": "#,0",
            "lineageTag": "9aa5cd06-c153-46a2-b0b2-824bfc1e3c85"
          },
          {
            "name": "Disrupted Flights",
            "expression": "SUM(FactFlight[DISRUPTED])",
            "formatString": "#,0",
            "lineageTag": "7b3a4e9b-ba33-4012-a040-7ced6271acf8"
          },
          {
            "name": "Cancellation Rate",
            "expression": "DIVIDE([Cancelled Flights], [Total Flights])",
            "formatString": "0.00%",
            "lineageTag": "3b8a11e3-f6e4-418d-afe5-e0115d0d3848"
          },
          {
            "name": "Diversion Rate",
            "expression": "DIVIDE([Diverted Flights], [Total Flights])",
            "formatString": "0.00%",
            "lineageTag": "f0813fc6-d50c-411b-b40a-92521b3af9a4"
          },
          {
            "name": "On-Time Rate",
            "expression": "DIVIDE([On-Time Flights], [Arrival Eligible Flights])",
            "formatString": "0.00%",
            "lineageTag": "60a09585-b26f-49c6-b465-00322b7ff897"
          },
          {
            "name": "On-Time Scheduled Rate",
            "expression": "DIVIDE([On-Time Flights], [Total Flights])",
            "formatString": "0.00%",
            "lineageTag": "af602b0b-4cd2-4082-8650-cff61804d4d4"
          },
          {
            "name": "Severe Delay Rate",
            "expression": "DIVIDE([Severe Flights], [Arrival Eligible Flights])",
            "formatString": "0.00%",
            "lineageTag": "b9e0ff15-740c-4c72-a79b-c8f54bc3bb3e"
          },
          {
            "name": "Disruption Rate",
            "expression": "DIVIDE([Disrupted Flights], [Total Flights])",
            "formatString": "0.00%",
            "lineageTag": "cc66f316-ff29-4957-b048-48b96b7aa43e"
          },
          {
            "name": "Average Arrival Delay",
            "expression": "AVERAGE(FactFlight[ARR_DELAY_ANALYSIS])",
            "formatString": "#,0.00",
            "lineageTag": "0f7cbb83-d5d0-41d0-be65-44cb81e8e0c1"
          },
          {
            "name": "Median Arrival Delay",
            "expression": "MEDIAN(FactFlight[ARR_DELAY_ANALYSIS])",
            "formatString": "#,0.00",
            "lineageTag": "ede1e21a-a6dd-4cc9-8073-16c586c04767"
          },
          {
            "name": "Average Departure Delay",
            "expression": "AVERAGE(FactFlight[DEP_DELAY_ANALYSIS])",
            "formatString": "#,0.00",
            "lineageTag": "f8ceca89-fff1-4635-b081-9c24abbb83a7"
          },
          {
            "name": "Median Departure Delay",
            "expression": "MEDIAN(FactFlight[DEP_DELAY_ANALYSIS])",
            "formatString": "#,0.00",
            "lineageTag": "cb28b6d0-8a12-48e4-8783-ded7c17a6e7a"
          },
          {
            "name": "P95 Arrival Delay",
            "expression": [
              "PERCENTILEX.INC(",
              "    FILTER(FactFlight, FactFlight[ARR_ELIGIBLE] = 1),",
              "    FactFlight[ARR_DELAY_ANALYSIS],",
              "    0.95",
              ")"
            ],
            "formatString": "#,0.00",
            "lineageTag": "a6f2191f-a4fd-4369-abd4-cbe49131ec80"
          },
          {
            "name": "Positive Arrival Minutes",
            "expression": "SUM(FactFlight[POSITIVE_ARR_MINUTES])",
            "formatString": "#,0",
            "lineageTag": "03cd7538-344a-4ea8-88b1-445ab6b1cfd2"
          },
          {
            "name": "Late Aircraft Minutes",
            "expression": "SUM(FactFlight[LATE_AIRCRAFT_DELAY])",
            "formatString": "#,0",
            "lineageTag": "de7de1ac-c67a-4b8e-a8a7-c2156618d69d"
          },
          {
            "name": "Airline Minutes",
            "expression": "SUM(FactFlight[AIRLINE_DELAY])",
            "formatString": "#,0",
            "lineageTag": "7f4145b4-512f-41dd-9d4d-bf7477971fce"
          },
          {
            "name": "NAS Minutes",
            "expression": "SUM(FactFlight[AIR_SYSTEM_DELAY])",
            "formatString": "#,0",
            "lineageTag": "cd26fdbc-62c3-4546-9da8-ff418f76d9aa"
          },
          {
            "name": "Weather Minutes",
            "expression": "SUM(FactFlight[WEATHER_DELAY])",
            "formatString": "#,0",
            "lineageTag": "40e88d99-f420-4640-9991-6f8a41b259f0"
          },
          {
            "name": "Security Minutes",
            "expression": "SUM(FactFlight[SECURITY_DELAY])",
            "formatString": "#,0",
            "lineageTag": "d52fe78e-aac4-4c22-ba58-298ab1853478"
          },
          {
            "name": "Reported Cause Minutes",
            "expression": "[Late Aircraft Minutes] + [Airline Minutes] + [NAS Minutes] + [Weather Minutes] + [Security Minutes]",
            "formatString": "#,0",
            "lineageTag": "7374f22b-7470-4ca8-9da2-200f4995067d"
          },
          {
            "name": "Late Aircraft Share of Reported Minutes",
            "expression": "DIVIDE([Late Aircraft Minutes], [Reported Cause Minutes])",
            "formatString": "0.00%",
            "lineageTag": "2fa921f0-2e34-4502-b3a7-48de1cd7177e"
          },
          {
            "name": "Cause Reported Flights",
            "expression": "SUM(FactFlight[CAUSE_REPORTED])",
            "formatString": "#,0",
            "lineageTag": "2805b232-dcd4-48cf-b2d7-69e06c86f9cb"
          },
          {
            "name": "Geographically Resolved Flights",
            "expression": "CALCULATE([Total Flights], KEEPFILTERS(FactFlight[GEO_ELIGIBLE] = 1))",
            "formatString": "#,0",
            "lineageTag": "33acd565-8516-434e-9516-f41b75cba4d8"
          },
          {
            "name": "Geographic Coverage",
            "expression": "DIVIDE([Geographically Resolved Flights], [Total Flights])",
            "formatString": "0.00%",
            "lineageTag": "50c0112c-61fd-4e21-9314-b15bd14f64fe"
          },
          {
            "name": "Time Issue Flights",
            "expression": "SUM(FactFlight[TIME_ISSUE])",
            "formatString": "#,0",
            "lineageTag": "e8a7251b-c4e4-4db2-8e62-ed08f3e5cebe"
          },
          {
            "name": "Airport Rate With Sample Threshold",
            "expression": "IF([Total Flights] >= 10000, [Severe Delay Rate])",
            "formatString": "0.00%",
            "lineageTag": "546841aa-cc57-414c-ac17-787353f05886"
          },
          {
            "name": "Route Rate With Sample Threshold",
            "expression": "IF([Total Flights] >= 1000, [Severe Delay Rate])",
            "formatString": "0.00%",
            "lineageTag": "0c6a1751-90f1-413a-976f-73d5ec9274a9"
          },
          {
            "name": "Data Scope Label",
            "expression": "\"Historical 2015 | Airport/route pages exclude October | Severe: arrival >=60 minutes\"",
            "lineageTag": "4555c1a7-0a15-4533-9743-7964ca027728"
          }
        ],
